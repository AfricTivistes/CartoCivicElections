---
import { useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<div class="band">
  <header class="hero wrap">
    <p class="kicker">{t("nav.contact")}</p>
    <h1>{t("contact.title")}</h1>
    <p class="lede">{t("contact.lede")}</p>
  </header>
</div>

<section class="sec">
  <div class="wrap cgrid">
    <form name="contact" method="POST" data-netlify="true" class="cform">
      <input type="hidden" name="form-name" value="contact" />
      <label>
        <span>{t("contact.first")}</span>
        <input name="firstname" autocomplete="given-name" required />
      </label>
      <label>
        <span>{t("contact.last")}</span>
        <input name="lastname" autocomplete="family-name" required />
      </label>
      <label class="full">
        <span>{t("contact.email")}</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label class="full">
        <span>{t("contact.message")}</span>
        <textarea name="message" rows="6" required></textarea>
      </label>
      <button class="btn btn-primary" type="submit">{t("contact.send")}</button>
    </form>
    <aside class="cside">
      <p>{t("contact.mail")}</p>
      <a href="mailto:info@africtivistes.org">info@africtivistes.org</a>
    </aside>
  </div>
</section>

<style>
  .cgrid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 40px 56px;
    align-items: start;
  }
  @media (max-width: 800px) {
    .cgrid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .cform {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .cform label {
    display: grid;
    gap: 6px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .cform .full {
    grid-column: 1 / -1;
  }
  .cform input,
  .cform textarea {
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 10px 12px;
  }
  .cform button {
    justify-self: start;
    border: 0;
  }
  @media (max-width: 520px) {
    .cform {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .cside {
    border-left: 3px solid var(--brand-yellow);
    padding-left: 16px;
    color: var(--ink-2);
  }
  .cside a {
    font-weight: 600;
    font-size: 17px;
  }
</style>

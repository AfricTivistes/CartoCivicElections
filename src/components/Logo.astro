---
/**
 * Logo Soobu d'origine. Deux versions générées depuis logo-soobu.svg :
 * light (couleurs d'origine) et dark (texte noir passé en blanc cassé,
 * flèches inchangées). tone="auto" suit le thème, tone="dark" sert au
 * bandeau noir du footer.
 */
import { Image } from "astro:assets";
import logoLight from "@images/logo-soobu-light.png";
import logoDark from "@images/logo-soobu-dark.png";

interface Props {
  class?: string;
  tone?: "auto" | "dark";
}
const { class: className = "", tone = "auto" } = Astro.props;
const alt = "Sóobu · AfricTivistes Tech4Elections";
---

{
  tone === "dark" ? (
    <Image src={logoDark} alt={alt} class={className} height={120} loading="eager" />
  ) : (
    <>
      <Image src={logoLight} alt={alt} class:list={[className, "logo-light"]} height={120} loading="eager" />
      <Image src={logoDark} alt={alt} class:list={[className, "logo-dark"]} height={120} loading="eager" />
    </>
  )
}

<style is:global>
  .logo-dark {
    display: none;
  }
  :root[data-theme="dark"] .logo-light {
    display: none;
  }
  :root[data-theme="dark"] .logo-dark {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .logo-light {
      display: none;
    }
    :root:not([data-theme="light"]) .logo-dark {
      display: block;
    }
  }
</style>

---
import MainLayout from "@/layouts/MainLayout.astro";
import InitiativeDetail from "@/components/InitiativeDetail.astro";
import { getInitiatives } from "@/lib/initiatives";
import { toRows } from "@/lib/normalize";
import type { Initiative } from "@/collections/initiatives/config";

export async function getStaticPaths() {
  const initiatives = await getInitiatives("en");
  const rows = toRows(initiatives, "en");
  return initiatives.map((initiative) => ({
    params: { slug: initiative.slug },
    props: { initiative, rows },
  }));
}

const { initiative, rows } = Astro.props as { initiative: Initiative; rows: ReturnType<typeof toRows> };
const description = initiative.description?.slice(0, 160);
---

<MainLayout lang="en" title={initiative.title} description={description}>
  <InitiativeDetail initiative={initiative} rows={rows} lang="en" />
</MainLayout>

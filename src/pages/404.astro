---
import MainLayout from "@/layouts/MainLayout.astro";
import { useT } from "@/i18n/ui";

const en = useT("en");
const fr = useT("fr");
---

<MainLayout lang="en" title={en("404.title")}>
  <div class="band">
    <header class="hero wrap">
      <p class="kicker">404</p>
      <h1>{en("404.title")} · <em>{fr("404.title")}</em></h1>
      <p class="lede">{en("404.text")}<br />{fr("404.text")}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/">{en("404.btn")}</a>
        <a class="btn btn-ghost" href="/fr/">{fr("404.btn")}</a>
      </div>
    </header>
  </div>
</MainLayout>
